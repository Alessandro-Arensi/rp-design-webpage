---
permalink: /_headers
eleventyExcludeFromCollections: true
---
# Long-cache fingerprinted assets. Eleventy Image filenames are content-hashed.
# Read by Cloudflare (and by Netlify, matching netlify.toml) from dist/_headers.
/assets/img/*
  Cache-Control: public, max-age=31536000, immutable

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
