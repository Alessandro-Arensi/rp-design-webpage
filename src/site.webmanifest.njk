---
permalink: /site.webmanifest
eleventyExcludeFromCollections: true
---
{
  "name": "{{ settings[site.defaultLang].siteName }}",
  "short_name": "{{ settings[site.defaultLang].siteName }}",
  "icons": [
    {
      "src": "/android-chrome-192x192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/android-chrome-512x512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "theme_color": "{{ settings[site.defaultLang].colors.ink }}",
  "background_color": "{{ settings[site.defaultLang].colors.bg }}",
  "display": "standalone"
}
