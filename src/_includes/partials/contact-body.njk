{# Contatti / Contact. Shared by src/it/contatti.njk and src/en/contact.njk —
   the two pages differ only by front matter, so everything locale-specific is
   resolved here from ui[lang] / contact[lang] and the localeHref filter. #}
<section class="section bleed page-top contact-head">
  <p class="eyebrow" data-reveal>{{ contact[lang].heading }}</p>
  <h1 class="statement" data-reveal>{{ contact[lang].intro }}<br>{{ contact[lang].introLine2 }}</h1>
</section>

<section class="contact-band">
  <div class="contact-band__inner">
    <div class="contact-form" data-reveal>
      <h2 class="contact-band__title">{{ contact[lang].formTitle }}</h2>
      <form name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="{{ collections.all | localeHref('thanks', lang) }}">
        <input type="hidden" name="form-name" value="contact">
        {# Netlify uses a submitted field named `subject` as the notification
           email's subject line. `value` is the static fallback a no-JS submit
           sends; contact-form.js substitutes {name} into data-subject-template
           when JS runs. Both strings are deliberately Italian in EN too — they
           land in the studio's own inbox, not in front of the visitor. #}
        {% set domain = site.url | host %}
        <input type="hidden" name="subject" value="{{ site.formSubject | replace('{domain}', domain) }}" data-subject-template="{{ site.formSubjectNamed | replace('{domain}', domain) }}">
        <p hidden><label>{{ ui[lang].botField }} <input type="text" name="bot-field"></label></p>
        <label>{{ ui[lang].name }}<input type="text" name="name" required></label>
        <label>{{ ui[lang].email }}<input type="email" name="email" required></label>
        <label>{{ ui[lang].message }}<textarea name="message" rows="5" required></textarea></label>
        <button class="btn btn--stroke" type="submit">{{ ui[lang].send }}</button>
        <p class="form-note">{{ ui[lang].formNote }}<a href="/privacy-policy/">{{ ui[lang].formNoteLink }}</a>.</p>
      </form>
    </div>
    <div class="contact-showroom" data-reveal>
      <h2 class="contact-band__title">{{ contact[lang].showroom.heading }}</h2>
      <address>
        <a href="https://maps.app.goo.gl/7rcYGewRCh8eLsQLA" target="_blank" rel="noopener">{{ contact[lang].address.street }}<br>{{ contact[lang].address.zip }} {{ contact[lang].address.city }}, {{ contact[lang].address.country }}</a>
        {% for p in contact[lang].phones %}<span class="contact-phone"><span class="contact-phone__label">{{ p.label }}</span><a href="tel:{{ p.number | replace(' ', '') }}">{{ p.number | replace(' ', '&nbsp;') | safe }}</a></span>{% endfor %}
      </address>
      <p class="contact-quote">“{{ contact[lang].showroom.text }}”</p>
    </div>
  </div>
</section>

{# Two showroom images at the foot of the page (per the contact mockup). #}
<section class="contact-gallery bleed" data-reveal>
  <figure>{% image "/assets/uploads/contatti/01.jpg", "Showroom", "(max-width:600px) 100vw, 50vw" %}</figure>
  <figure>{% image "/assets/uploads/contatti/02.jpg", "Showroom", "(max-width:600px) 100vw, 50vw" %}</figure>
</section>
