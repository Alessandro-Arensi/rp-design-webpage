{# Home intro curtain. Decorative (aria-hidden); first visit only (html.intro-play).
   The curtain shows the hero's first carousel image (+ the same overlay) while the
   logo signs itself (Lottie); intro.js lifts it into the identical hero. no-JS /
   reduced-motion skip it. The old hand-drawn signature (firma-payoff-anim.svg) is
   retained but disabled. #}
<div class="intro" data-intro aria-hidden="true">
  {% set slides = settings[lang].homeSlides %}
  {% set introBg = slides[0].image if slides and slides.length else settings[lang].homeHero %}
  {% image introBg, "", "100vw", { eager: true, class: "intro__bg" } %}
  <div class="intro__overlay"></div>
  <div class="intro__lottie" data-intro-lottie></div>
</div>
